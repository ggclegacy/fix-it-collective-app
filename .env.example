# Optional. Default local database is ./data/collective.sqlite (ignored by Git).
DATABASE_PATH=./data/collective.sqlite
# Required when running the production server. Must match the browser origin.
APP_ORIGIN=http://127.0.0.1:3000
# Development server seeds automatically. Opt in only for an isolated preview database.
SEED_DEMO=false
# Payment and message adapters deliberately have no credentials or active providers yet.
# Required to store/read confidential massage intake. A stable, random 32-byte key in hex.
# Generate using a secure secrets manager; back it up separately from the database.
RECOVERY_ENCRYPTION_KEY=
# Only needed if this database has historical private_intakes from the earlier booking flow.
# New bookings and SOAP use RECOVERY_ENCRYPTION_KEY. Retain the original legacy key until those records are migrated.
INTAKE_ENCRYPTION_KEY=
# Optional explicitly authorized Recovery practitioners (comma-separated existing user IDs).
# Front-desk roles are denied clinical access regardless of this allowlist.
RECOVERY_PRACTITIONER_USER_IDS=
